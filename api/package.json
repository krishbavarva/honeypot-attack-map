{
  "name": "honeypot-api",
  "version": "0.2.0",
  "description": "REST + live (Server-Sent Events) API for the honeypot attack map",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node --env-file-if-exists=../.env src/server.js",
    "dev": "node --watch --env-file-if-exists=../.env src/server.js",
    "simulate": "node --env-file-if-exists=../.env scripts/simulate.js",
    "simulate:clean": "node --env-file-if-exists=../.env scripts/simulate.js --clean"
  },
  "dependencies": {
    "pg": "^8.13.0"
  },
  "engines": {
    "node": ">=22.9"
  }
}
