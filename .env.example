# Copy this file to ".env" and change the password.
# ".env" is in .gitignore: your real secrets never go to GitHub.

POSTGRES_USER=honeypot
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB=honeypot

# The collector uses the same POSTGRES_* values above to connect (host: localhost).

# Path to the MaxMind GeoLite2 City database (optional until you download it)
GEOIP_DB=../geoip/GeoLite2-City.mmdb

# API (optional, these are the defaults)
# API_PORT=4000
# DASHBOARD_ORIGIN=http://localhost:5173
